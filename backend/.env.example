APP_NAME=Toyota Control Center API
APP_VERSION=0.1.0
AUTH_SCHEME=Bearer

# Local dev default; override per environment.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/control_center
DB_ECHO=false

# AWS/RDS readiness knobs.
# local | require | verify-ca | verify-full
DB_SSL_MODE=local
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
# OpenAI Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY={key}
OPENAI_MODEL=gpt-4o